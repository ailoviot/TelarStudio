      "conexiones": [
        {
          "clave": "voltage",
          "tipo": "adc-in",
          "pinForzado": 34,
          "params": {
            "muestras": 32,
            "unidad": "kV"
          }
        },
        {
          "clave": "pwm_out",
          "tipo": "pwm-out",
          "pinForzado": 25,
          "params": {
            "frecuencia": 1000,
            "resolucion": "8",
            "rango": "0–255",
            "inicial": 21
          }
        },
        {
          "clave": "brake",
          "tipo": "gpio-out",
          "pinForzado": 26,
          "params": {}
        },
        {
          "clave": "dir",
          "tipo": "gpio-out",
          "pinForzado": 27,
          "params": {}
        },
        {
          "clave": "bip",
          "tipo": "gpio-out",
          "pinForzado": 32,
          "params": {
            "activo": "alto"
          }
        }
      ]
    }
  ],
  "enlace": {
    "tipo": "rs485",
    "baudios": 19200
