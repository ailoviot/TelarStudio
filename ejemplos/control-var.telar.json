  "iNodo": 0,
  "ajustes": [],
  "estados": [],
  "logica": "variables:\n  setpoint: { type: setting, unit: kV, range: [0, 100], step: 0.1, start: 0 }\n  clock: { type: setting, unit: s, range: [0, 900], step: 1, start: 0 }\n  hold_time: {type: timer, from: clock, counts: down}\n \n\nstart_in: IDLE\nclick: bip   \nstates: \n  IDLE:     \n    on enter: [load clock, set pwm_out to 0, turn on dir, turn off bip] \n      \n  START:\n    on enter: [set pwm_out to 21, turn off brake]      \n    if setpoint > 0 and voltage >= setpoint: [go to RUNNING]     \n      \n  RUNNING:\n    on enter: [restart hold_time, set pwm_out to 0, turn on brake]  \n    while: [count hold_time]    \n    if hold_time == 0: [go to FINISHED]    \n     \n  FINISHED:\n    on enter: [set pwm_out to 21, turn off brake, turn off dir, blink bip on 2 off 2 for 14]    \n    if voltage <= 0.4: [go to IDLE]\n    \n  RETURN:\n   on enter: [set pwm_out to 21, turn off brake, turn off dir]\n   if voltage <= 0.4: [go to IDLE] \n\n        \n    \nbuttons:\n   btn_time_minus:\n     always: [decrease clock]\n     repeat: yes\n     \n   btn_time_plus:\n     always: [increase clock]\n     repeat: yes  \n\n   btn_tension_down:\n     always: [decrease setpoint]\n     repeat: yes\n     \n   btn_tension_up:\n     always: [increase setpoint]\n     repeat: yes    \n    \n   btn_cl_00:\n     always: [set setpoint to 2.5]  \n     \n   btn_cl_0:\n     always: [set setpoint to 5]\n          \n   btn_cl_1:\n     always: [set setpoint to 10] \n     \n   btn_cl_2:\n     always: [set setpoint to 20] \n     \n   btn_cl_3:\n     always: [set setpoint to 30]\n        \n   btn_cl_4:\n     always: [set setpoint to 40]              \n   \n   btn_save:\n     in IDLE: [save clock, save setpoint]  \n        \n   btn_load:\n     in IDLE: [load clock, load setpoint]        \n     \n   btn_start:\n     in IDLE: [go to START] \n         \n   btn_stop:\n    in START:   [go to RETURN]\n    in RUNNING: [go to RETURN]\n     \nlooks:\n    btn_cl_00, btn_cl_0, btn_cl_1, btn_cl_2, btn_cl_3, btn_cl_4,\n    btn_time_minus, btn_time_plus, btn_tension_down, btn_tension_up,\n    btn_save, btn_load:\n     in  RUNNING: {disabled: yes, color: \"#7abdff\"}    \n         \n     \n              ",
