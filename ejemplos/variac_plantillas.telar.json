  "contador": 158,
  "logica": "cycle:\n  variables:\n    setpoint:   { type: setting, unit: kV, range: [0, 100], step: 1, start: 30 }\n    hold_time:  { type: setting, unit: s, range: [0, 3600], step: 5, start: 60 }\n    remaining:  { type: timer, from: hold_time, counts: down }\n    zero_level: { type: setting, unit: kV, range: [0, 5], step: 0.1, start: 0.5 }\n\n  start_in: IDLE\n  states:\n    IDLE:\n      on enter: [set pwm_out to 0, turn off motor_brake, turn off relay, restart remaining]\n    RAISING:\n      on enter: [turn on relay, turn on motor_dir, set pwm_out to 21]\n      if voltage >= setpoint: [go to HOLDING]\n    HOLDING:\n      on enter: [set pwm_out to 0, restart remaining]\n      while: [count remaining]\n      if remaining == 0: [go to LOWERING]\n    LOWERING:\n      on enter: [turn off motor_dir, set pwm_out to 21]\n      if voltage <= zero_level: [go to IDLE]\n\n  buttons:\n    btn_minus:\n      in IDLE: [decrease setpoint]\n      repeat: yes\n    btn_plus:\n      in IDLE: [increase setpoint]\n      repeat: yes\n    setting_2_minus:\n      in IDLE: [decrease hold_time, restart remaining]\n      repeat: yes\n    setting_2_plus:\n      in IDLE: [increase hold_time, restart remaining]\n      repeat: yes\n    btn_start:\n      in IDLE: [go to RAISING]\n    btn_stop:\n      always: [go to IDLE]\n\n  looks:\n    btn_start:\n      in IDLE:     { text: START,    color: green }\n      in RAISING:  { text: RAISING,  color: amber }\n      in HOLDING:  { text: HOLDING,  color: blue }\n      in LOWERING: { text: LOWERING, color: amber }\n    countdown:\n      in HOLDING:  { color: blue }\n    reading:\n      in RAISING:  { color: amber }\n      in LOWERING: { color: amber }\n",
  "placas_propias": {},
  "pantallas_propias": {}
}